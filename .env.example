# --- Servidor ---
PORT=3000
BASE_URL=https://aqui.online

# --- Base de datos ---
# En Vercel: agrega Vercel Postgres / Neon y usa su POSTGRES_URL o DATABASE_URL.
# Local: si no defines nada, usa SQLite en ./data/aqui.db
# DATABASE_URL=postgres://user:pass@host/db

# --- API ---
# Si defines API_KEY, los POST del API requieren "Authorization: Bearer <API_KEY>".
# Las lecturas siempre son públicas.
# API_KEY=

# --- Email (SendGrid) ---
# El remitente está fijo en el código: a@torrenegra.com (src/env.js)
# SENDGRID_API_KEY=

# --- Reconocimiento facial (AWS Rekognition) ---
# Sin estas credenciales las fotos se guardan pero no hay matching.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# FACE_COLLECTION_ID=aqui-faces
# FACE_MATCH_THRESHOLD=90

# --- WhatsApp (Meta Cloud API) — pendiente de credenciales ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=aqui-verify
